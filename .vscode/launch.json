{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Launch ClientApp (.NET 8)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/desktop/ClientApp/bin/Debug/net8.0-windows/win-x64/ClientApp.dll",
      "args": [],
      "cwd": "${workspaceFolder}/desktop/ClientApp",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ROOT": "${env:LocalAppData}/Microsoft/dotnet",
        "PATH": "${env:LocalAppData}/Microsoft/dotnet;${env:PATH}"
      }
    },
    {
      "name": "2. Launch CoreProvisioningConsole (.NET 8)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/desktop/CoreProvisioningConsole/bin/Debug/net8.0-windows/win-x64/CoreProvisioningConsole.dll",
      "args": [],
      "cwd": "${workspaceFolder}/desktop/CoreProvisioningConsole",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ROOT": "${env:LocalAppData}/Microsoft/dotnet",
        "PATH": "${env:LocalAppData}/Microsoft/dotnet;${env:PATH}"
      }
    },
    {
      "name": "3. Launch Backend API (Wrangler Dev)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "4. Launch Standalone ClientApp.exe (Release)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "publish-single-file",
      "program": "${workspaceFolder}/dist/ClientApp/ClientApp.exe",
      "args": [],
      "cwd": "${workspaceFolder}/dist/ClientApp",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "DOTNET_ROOT": "${env:LocalAppData}/Microsoft/dotnet",
        "PATH": "${env:LocalAppData}/Microsoft/dotnet;${env:PATH}"
      }
    },
    {
      "name": "5. Attach to Running .NET Process",
      "type": "coreclr",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Fullstack: Backend API + ClientApp",
      "configurations": [
        "3. Launch Backend API (Wrangler Dev)",
        "1. Launch ClientApp (.NET 8)"
      ],
      "stopAll": true
    }
  ]
}
