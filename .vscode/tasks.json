{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "shell",
      "command": "dotnet build \"${workspaceFolder}/desktop/ClientApp/ClientApp.csproj\" /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-console",
      "type": "shell",
      "command": "dotnet build \"${workspaceFolder}/desktop/CoreProvisioningConsole/CoreProvisioningConsole.csproj\" /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish-single-file",
      "type": "shell",
      "command": "cmd /c \"${workspaceFolder}/build-exe.bat\"",
      "problemMatcher": []
    },
    {
      "label": "run-desktop-app",
      "type": "shell",
      "command": "dotnet run --project \"${workspaceFolder}/desktop/ClientApp/ClientApp.csproj\"",
      "problemMatcher": []
    },
    {
      "label": "backend-dev",
      "type": "npm",
      "script": "dev",
      "path": "backend",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Ready on.*|.*Starting.*",
          "endsPattern": ".*Ready on http://localhost:8787.*|.*http://127.0.0.1:8787.*"
        }
      }
    },
    {
      "label": "db-migrate-local",
      "type": "npm",
      "script": "db:migrate:local",
      "path": "backend",
      "problemMatcher": []
    },
    {
      "label": "db-seed-local",
      "type": "npm",
      "script": "db:seed:local",
      "path": "backend",
      "problemMatcher": []
    }
  ]
}
