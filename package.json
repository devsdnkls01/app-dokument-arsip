{
  "name": "my-document-app-monorepo",
  "version": "1.0.0",
  "description": "Monorepo for Document Automation & Archive System",
  "private": true,
  "scripts": {
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:client": "dotnet run --project desktop/ClientApp/ClientApp.csproj",
    "dev:console": "dotnet run --project desktop/CoreProvisioningConsole/CoreProvisioningConsole.csproj",
    "build:client": "dotnet publish desktop/ClientApp/ClientApp.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=None -p:DebugSymbols=false -p:OptimizationPreference=Speed -o ./dist/ClientApp",
    "build:console": "dotnet publish desktop/CoreProvisioningConsole/CoreProvisioningConsole.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:DebugType=None -p:DebugSymbols=false -p:OptimizationPreference=Speed -o ./dist/CoreProvisioningConsole",
    "build:all": "cmd /c build-exe.bat",
    "db:migrate:local": "npm --prefix backend run db:migrate:local",
    "db:seed:local": "npm --prefix backend run db:seed:local",
    "deploy:backend": "npm --prefix backend run deploy"
  }
}
