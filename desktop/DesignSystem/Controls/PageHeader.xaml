<UserControl x:Class="DesignSystem.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="RootHeader">
    <Border Background="{DynamicResource SurfaceCardBrush}"
            BorderBrush="{DynamicResource BorderLightBrush}"
            BorderThickness="0,0,0,1"
            Padding="28,20">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Title & Subtitle -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding ElementName=RootHeader, Path=Title}"
                           Style="{StaticResource TitleStyle}"
                           Margin="0,0,0,3"/>
                <TextBlock Text="{Binding ElementName=RootHeader, Path=Subtitle}"
                           Style="{StaticResource BodyMutedStyle}"/>
            </StackPanel>

            <!-- Actions Container -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Custom Actions Slot -->
                <ContentPresenter Content="{Binding ElementName=RootHeader, Path=ExtraActions}" Margin="0,0,10,0"/>

                <!-- Secondary Button (e.g. Refresh) -->
                <ui:Button x:Name="BtnSecondary"
                           Appearance="Secondary"
                           Command="{Binding ElementName=RootHeader, Path=SecondaryActionCommand}"
                           Visibility="{Binding ElementName=RootHeader, Path=HasSecondaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="0,0,10,0"
                           Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing IsIndeterminate="True"
                                         Width="14" Height="14"
                                         Margin="0,0,8,0"
                                         Visibility="{Binding ElementName=RootHeader, Path=IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ui:SymbolIcon Symbol="{Binding ElementName=RootHeader, Path=SecondaryActionIcon}"
                                       FontSize="14"
                                       Margin="0,0,8,0"
                                       Visibility="{Binding ElementName=RootHeader, Path=IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding ElementName=RootHeader, Path=SecondaryActionText}"
                                   Style="{StaticResource CaptionStyle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>

                <!-- Primary Action Button (Accent) -->
                <ui:Button x:Name="BtnPrimary"
                           Appearance="Primary"
                           Command="{Binding ElementName=RootHeader, Path=PrimaryActionCommand}"
                           Visibility="{Binding ElementName=RootHeader, Path=HasPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Padding="16,8">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="{Binding ElementName=RootHeader, Path=PrimaryActionIcon}"
                                       FontSize="14"
                                       Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding ElementName=RootHeader, Path=PrimaryActionText}"
                                   Style="{StaticResource CaptionStyle}"
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
