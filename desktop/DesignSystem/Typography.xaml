<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- ENTERPRISE TYPOGRAPHY HIERARCHY (SEGOE UI VARIABLE & MONO)        -->
    <!-- Display / Title / Subtitle / Body / Caption / Monospace           -->
    <!-- ================================================================= -->

    <FontFamily x:Key="EnterpriseFontFamily">Segoe UI Variable Text, Segoe UI, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="EnterpriseDisplayFontFamily">Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif</FontFamily>
    <FontFamily x:Key="EnterpriseMonoFontFamily">Cascadia Mono, Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- 1. DISPLAY STYLE (Large KPI figures, hero titles) -->
    <Style x:Key="DisplayStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseDisplayFontFamily}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- 2. TITLE STYLE (Page titles, major section headers) -->
    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseFontFamily}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- 3. SUBTITLE STYLE (Card headers, modal titles) -->
    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseFontFamily}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- 4. BODY STYLE (Default reading text, table cells) -->
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <!-- 5. BODY MUTED STYLE (Descriptions, subtitles) -->
    <Style x:Key="BodyMutedStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- 6. CAPTION STYLE (Helper text, metadata, badges) -->
    <Style x:Key="CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseFontFamily}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- 7. MONO / CODE STYLE (License keys, hashes, tokens) -->
    <Style x:Key="CodeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource EnterpriseMonoFontFamily}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

</ResourceDictionary>
