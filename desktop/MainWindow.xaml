<Window x:Class="SuratApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SuratApp"
        mc:Ignorable="d"
        Title="DocuFlow - Otomasi Dokumen &amp; Manajemen Arsip Digital" 
        Height="800" Width="1320"
        MinHeight="680" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBgBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- In-App Update Alert Banner (Collapsible) -->
            <RowDefinition Height="Auto"/>
            <!-- Top App Bar -->
            <RowDefinition Height="64"/>
            <!-- Main 3-Column Content Area -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar -->
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- IN-APP UPDATE NOTIFICATION BANNER (D1 & Cloudinary/Drive) -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" x:Name="BannerUpdate" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="0,0,0,1" Padding="14,8" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🚀 " FontSize="14"/>
                    <TextBlock x:Name="TxtUpdateMsg" Text="Versi baru aplikasi telah tersedia!" FontWeight="SemiBold" Foreground="#92400E" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Unduh Versi Terbaru (.exe)" Click="BtnDownloadUpdate_Click" Style="{StaticResource ModernButton}" Background="#D97706" Padding="12,4" Height="28" FontSize="11" Margin="0,0,8,0"/>
                    <Button Content="✕" Click="BtnDismissUpdate_Click" Background="Transparent" BorderThickness="0" Foreground="#78350F" FontWeight="Bold" Width="24" Height="24" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- TOP APP BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="8" Width="38" Height="38" Margin="0,0,12,0">
                        <TextBlock Text="📄" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DOCUFLOW PRO ARSIP" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextMainBrush}"/>
                        <TextBlock Text="Otomasi Dokumen, Penomoran Otomatis &amp; Validasi QR Code" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Top Actions & Server / PIN Config -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Export Agenda Excel Button -->
                    <Button Content="📊 Ekspor Buku Agenda (Excel)" Click="BtnExportAgenda_Click" Style="{StaticResource SecondaryButton}" Height="34" Margin="0,0,14,0"/>

                    <TextBlock Text="PIN API:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                    <PasswordBox x:Name="TxtAppPin" Password="123456" Width="80" Height="32" VerticalContentAlignment="Center" Margin="0,0,10,0"/>

                    <TextBlock Text="API Worker:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium"/>
                    <TextBox x:Name="TxtApiUrl" Width="180" Height="32" Text="http://127.0.0.1:8787" Style="{StaticResource ModernTextBox}" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                    <Button x:Name="BtnConnect" Content="Hubungkan" Click="BtnConnect_Click" Style="{StaticResource SecondaryButton}" Height="32" Padding="12,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- MAIN 3-PANEL LAYOUT -->
        <!-- ========================================================= -->
        <Grid Grid.Row="2" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <!-- Panel 1: Kategori, Draf & Riwayat (Left) -->
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="14"/>
                <!-- Panel 2: Dynamic Form & Generator (Center) -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <!-- Panel 3: Dropzone Arsip Scan Basah (Right) -->
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================== -->
            <!-- PANEL 1: KATEGORI, DRAF OFFLINE & RIWAYAT -->
            <!-- ===================================================== -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header Kategori -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="KATEGORI SURAT" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="+ Scan .docx Baru" Click="BtnScanNewDocx_Click" Background="Transparent" BorderThickness="0" Foreground="#2563EB" Cursor="Hand" FontSize="11"/>
                    </Grid>

                    <!-- ListBox Kategori -->
                    <ListBox Grid.Row="1" x:Name="ListCategories" 
                             SelectionChanged="ListCategories_SelectionChanged"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#EFF6FF" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Code}" FontWeight="Bold" FontSize="10" Foreground="#1D4ED8"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Header Riwayat Dokumen & Search Bar -->
                    <StackPanel Grid.Row="2" Margin="0,10,0,6">
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="RIWAYAT SURAT KELUAR" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="↻ Refresh" Click="BtnRefreshDocs_Click" Background="Transparent" BorderThickness="0" Foreground="#2563EB" Cursor="Hand" FontSize="11"/>
                        </Grid>
                        <!-- Quick Search Box -->
                        <TextBox x:Name="TxtSearchDoc" Height="28" Padding="6,2" TextChanged="TxtSearchDoc_TextChanged" Style="{StaticResource ModernTextBox}" Tag="Cari nomor/perihal..."/>
                    </StackPanel>

                    <!-- ListBox Riwayat Dokumen (Dengan Indikator Warna Merah/Hijau) -->
                    <ListBox Grid.Row="3" x:Name="ListDocuments" 
                             SelectionChanged="ListDocuments_SelectionChanged"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DocumentNumber}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            <!-- Scan Status Badge: Merah = Belum, Hijau = Lengkap -->
                                            <Border Grid.Column="1" CornerRadius="10" Padding="6,2" Background="{Binding ScanBadgeBg}">
                                                <TextBlock Text="{Binding ScanStatusText}" FontSize="9" FontWeight="Bold" Foreground="{Binding ScanBadgeFg}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" FontSize="10" Foreground="#475569" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- PANEL 2: DYNAMIC FORM GENERATOR -->
            <!-- ===================================================== -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Category Header & Auto Number Button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSelectedCategoryTitle" Text="Pilih Kategori Surat" FontWeight="Bold" FontSize="17" Foreground="{StaticResource TextMainBrush}"/>
                            <TextBlock x:Name="TxtSelectedCategoryDesc" Text="Pilih kategori di panel kiri untuk memuat form isian dinamis." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                        <!-- Button Auto Numbering -->
                        <Button Grid.Column="1" Content="🔢 Ambil Nomor Otomatis" Click="BtnAutoNumber_Click" Style="{StaticResource SecondaryButton}" Height="32"/>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,10,0,12" Background="{StaticResource BorderLightBrush}"/>

                    <!-- Container Dynamic Form -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0">
                        <StackPanel x:Name="DynamicFormContainer">
                            <TextBlock Text="Pilih kategori dari menu di sebelah kiri untuk mengisi form." 
                                       FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}" 
                                       Margin="0,40,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Action Controls -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <!-- Progress bar -->
                        <ProgressBar x:Name="FormProgressBar" Height="4" IsIndeterminate="False" Visibility="Collapsed" Margin="0,0,0,10"/>

                        <!-- Options & Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox x:Name="ChkEnableQr" Content="Sematkan QR Validasi Keaslian" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium" Foreground="#334155"/>

                            <Button Grid.Column="1" Content="💾 Simpan Draf Offline" Click="BtnSaveDraft_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>

                            <Button Grid.Column="3" x:Name="BtnGenerateAndArchive" Content="⚡ Generate &amp; Unggah Arsip (.docx)" 
                                    Click="BtnGenerateAndArchive_Click" Style="{StaticResource ModernButton}"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===================================================== -->
            <!-- PANEL 3: DROPZONE ARSIP SCAN BASAH & QR VERIFIKASI -->
            <!-- ===================================================== -->
            <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="10" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ARSIP FISIK SCAN BASAH" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextMainBrush}"/>
                    <TextBlock Grid.Row="1" Text="Tautkan berkas fisik PDF/JPG berstempel basah (otomatis dikompres hemat kuota)." 
                               FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,2,0,10"/>

                    <!-- Active Document Info Card -->
                    <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Target Dokumen Terpilih:" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                            <TextBlock x:Name="TxtTargetDocNumber" Text="Belum ada dokumen dipilih" FontWeight="Bold" FontSize="12" Foreground="#0F172A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtTargetDocId" Text="ID: -" FontSize="9" Foreground="#94A3B8"/>
                            <TextBlock x:Name="TxtExistingScanStatus" Text="Status: Belum Ada Scan Basah" FontSize="11" Foreground="#DC2626" FontWeight="Bold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Drag & Drop Dropzone Area -->
                    <Border Grid.Row="3" x:Name="DropZoneBorder" 
                            Background="#F8FAFC" 
                            BorderBrush="#94A3B8" 
                            BorderThickness="2" 
                            CornerRadius="8" 
                            AllowDrop="True"
                            DragEnter="DropZone_DragEnter"
                            DragLeave="DropZone_DragLeave"
                            Drop="DropZone_Drop"
                            Margin="0,0,0,10">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Margin="10">
                                <TextBlock Text="📥" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Tarik File Scan ke Sini" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center" Foreground="#334155"/>
                                <TextBlock Text="PDF, JPG, PNG" FontSize="10" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,2,0,6"/>
                                <Button Content="Pilih File..." Click="BtnBrowseScanFile_Click" Style="{StaticResource SecondaryButton}" Padding="8,2" HorizontalAlignment="Center" FontSize="11"/>
                                <TextBlock x:Name="TxtDroppedFileName" Text="" FontStyle="Italic" FontSize="10" Foreground="#2563EB" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Upload Scan Action & Quick Links -->
                    <StackPanel Grid.Row="4">
                        <Button x:Name="BtnUploadScan" Content="Tautkan Scan Basah ke Arsip" 
                                Click="BtnUploadScan_Click" Style="{StaticResource SuccessButton}" Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock>
                                <Hyperlink x:Name="LnkViewDocx" Click="LnkViewDocx_Click">Lihat .docx</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="  •  " Foreground="#94A3B8"/>
                            <TextBlock>
                                <Hyperlink x:Name="LnkViewScan" Click="LnkViewScan_Click">Lihat Scan</Hyperlink>
                            </TextBlock>
                            <TextBlock Text="  •  " Foreground="#94A3B8"/>
                            <TextBlock>
                                <Hyperlink x:Name="LnkVerifyPublic" Click="LnkVerifyPublic_Click">Cek QR Publik</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- BOTTOM STATUS BAR -->
        <!-- ========================================================= -->
        <Border Grid.Row="3" Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Text="Siap." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Grid.Column="1" Text="Local Engine • Atomic Counter • QR Validation • Edge D1" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
