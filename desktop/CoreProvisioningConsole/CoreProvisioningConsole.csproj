<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Sovereign Executive Windows Assembly Metadata (Enterprise Camouflage) -->
    <AssemblyName>CoreProvisioningConsole</AssemblyName>
    <RootNamespace>CoreProvisioningConsole</RootNamespace>
    <Company>Sovereign Executive Systems</Company>
    <Product>Sovereign Executive Core Provisioning Console</Product>
    <Copyright>Copyright © 2026 Sovereign Systems. All rights reserved.</Copyright>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <ApplicationVersion>1.0.0.0</ApplicationVersion>
    <Description>Enterprise System Provisioning &amp; Node Entitlement Management Console</Description>

    <!-- Anti-Inspection & Production Hardening -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Optimize>true</Optimize>

    <!-- Single-File Self-Contained Deployment Options -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.2" />
    <PackageReference Include="WPF-UI" Version="3.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DesignSystem\DesignSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
