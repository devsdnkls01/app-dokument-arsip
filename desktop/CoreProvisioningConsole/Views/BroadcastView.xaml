<UserControl x:Class="CoreProvisioningConsole.Views.BroadcastView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <ds:PageHeader Grid.Row="0"
                       Title="Pusat Siaran &amp; Buletin Eksekutif"
                       Subtitle="Kelola teks berjalan (running ticker), nomor WhatsApp Gateway tersembunyi, dan banner buletin instansi."
                       PrimaryActionText="Simpan Semua Pengaturan"
                       PrimaryActionIcon="Save24"
                       PrimaryActionCommand="{Binding SaveBroadcastCommand}"
                       SecondaryActionText="Segarkan"
                       SecondaryActionIcon="ArrowSync24"
                       SecondaryActionCommand="{Binding LoadBroadcastCommand}"
                       IsLoading="{Binding IsLoading}"/>

        <!-- MAIN BODY: 2 COLUMN ENTERPRISE CARDS -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <Grid MaxWidth="1600">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN: RUNNING TICKER & STEALTH WHATSAPP GATEWAY -->
                <StackPanel Grid.Column="0">
                    <!-- Card 1: Running Ticker -->
                    <Border Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="24"
                            Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="TEKS BERJALAN (STATUS BAR TICKER)" Style="{StaticResource TitleStyle}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="Pesan pengumuman darurat atau pemeliharaan yang berjalan di bawah layar ClientApp." Style="{StaticResource BodyMutedStyle}" Margin="0,0,0,16"/>

                            <TextBlock Text="Isi Teks Berjalan" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding RunningText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Height="70"
                                        TextWrapping="Wrap"
                                        AcceptsReturn="True"
                                        Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Warna Latar Hex (#1E40AF)" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding RunningTextBgColor, Mode=TwoWay}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Versi Terbaru Client" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding AppLatestVersion, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Live Ticker Preview -->
                            <TextBlock Text="Pratinjau Tampilan Ticker:" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,6"/>
                            <Border Background="#1E40AF" CornerRadius="{StaticResource RadiusSmall}" Padding="12,8">
                                <TextBlock Text="{Binding RunningText}" Foreground="#FFFFFF" Style="{StaticResource CaptionStyle}" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Stealth WhatsApp Gateway Control -->
                    <Border Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="NOMOR TUJUAN 'HUBUNGI KAMI' (WHATSAPP GATEWAY)" Style="{StaticResource TitleStyle}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="Seluruh tombol bantuan dan upgrade di ClientApp mengarahkan ke nomor ini secara tersembunyi tanpa pernah menampilkan nomor di layar klien." Style="{StaticResource BodyMutedStyle}" Margin="0,0,0,16"/>

                            <TextBlock Text="Nomor WhatsApp Resmi Pusat (Format Internasional: 628...)" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding SupportChannelUri, Mode=TwoWay}"
                                        PlaceholderText="628589584257"
                                        Margin="0,0,0,10"/>
                            <TextBlock Text="✅ Perubahan nomor ini langsung aktif di seluruh instansi tanpa perlu kompilasi ulang ClientApp.exe."
                                       Style="{StaticResource CaptionStyle}"
                                       Foreground="{DynamicResource StatusSuccessFgBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT COLUMN: POP-UP PROMO / EXECUTIVE BULLETIN BANNER -->
                <StackPanel Grid.Column="2">
                    <Border Background="{DynamicResource SurfaceCardBrush}"
                            BorderBrush="{DynamicResource BorderLightBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusLarge}"
                            Padding="24">
                        <StackPanel>
                            <TextBlock Text="BULETIN EKSEKUTIF &amp; BANNER PROMOSI" Style="{StaticResource TitleStyle}" FontSize="15" Margin="0,0,0,4"/>
                            <TextBlock Text="Pop-up modal penawaran khusus yang muncul sekali saat pengguna instansi login." Style="{StaticResource BodyMutedStyle}" Margin="0,0,0,16"/>

                            <CheckBox Content="Aktifkan Pop-up Buletin Saat Pengguna Instansi Login"
                                      IsChecked="{Binding PopupEnabled, Mode=TwoWay}"
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,14"/>

                            <TextBlock Text="Judul Buletin Eksekutif" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding PopupTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="contoh: Penawaran Peningkatan Paket Instansi"
                                        Margin="0,0,0,12"/>

                            <TextBlock Text="Teks Tombol Tindakan (CTA)" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <ui:TextBox Text="{Binding PopupCtaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="[ 💬 Hubungi Kami ]"
                                        Margin="0,0,0,16"/>

                            <!-- Live Modal Preview -->
                            <TextBlock Text="Pratinjau Pop-up Modal:" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <Border Background="{DynamicResource SurfaceCardSecondaryBrush}"
                                    BorderBrush="{DynamicResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="20">
                                <StackPanel>
                                    <TextBlock Text="{Binding PopupTitle}" Style="{StaticResource SubtitleStyle}" Margin="0,0,0,10"/>
                                    <Border Height="110" Background="#FFFFFF" CornerRadius="{StaticResource RadiusSmall}" Margin="0,0,0,12">
                                        <TextBlock Text="📢 Banner Grafis Buletin" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ui:Button Appearance="Primary"
                                               Content="{Binding PopupCtaText}"
                                               HorizontalAlignment="Stretch"
                                               Padding="12,8"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
