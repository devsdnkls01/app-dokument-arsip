<UserControl x:Class="CoreProvisioningConsole.Views.TiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <ds:PageHeader Grid.Row="0"
                       Title="Pengaturan Paket &amp; Limitasi Tier"
                       Subtitle="Konfigurasi dinamis kuota pengguna, kapasitas penyimpanan edge, dan ketersediaan modul per tier."
                       SecondaryActionText="Segarkan"
                       SecondaryActionIcon="ArrowSync24"
                       SecondaryActionCommand="{Binding LoadTiersCommand}"
                       IsLoading="{Binding IsLoading}"/>

        <!-- MAIN CONTENT: TIER CARDS GRID -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <ItemsControl ItemsSource="{Binding Tiers}" MaxWidth="1600">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="360"
                                Background="{DynamicResource SurfaceCardBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusLarge}"
                                Padding="22"
                                Margin="0,0,20,20">
                            <StackPanel>
                                <!-- Header: Tier Chip + Display Name -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource TitleStyle}" FontSize="18"/>
                                        <TextBlock Text="{Binding PriceLabel}" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Foreground="{DynamicResource EnterpriseAccentBrush}"/>
                                    </StackPanel>
                                    <ds:TierChip Grid.Column="1" TierId="{Binding TierId}" VerticalAlignment="Top"/>
                                </Grid>

                                <Separator Margin="0,0,0,16" Background="{DynamicResource BorderLightBrush}"/>

                                <!-- Editable Limits -->
                                <TextBlock Text="Maksimal Pengguna (User Accounts)" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding MaxUsers, Mode=TwoWay}" Margin="0,0,0,12"/>

                                <TextBlock Text="Kapasitas Cloud Storage (MB)" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding MaxStorageMb, Mode=TwoWay}" Margin="0,0,0,14"/>

                                <TextBlock Text="Label Harga / Periode Penagihan" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,4"/>
                                <ui:TextBox Text="{Binding PriceLabel, Mode=TwoWay}" Margin="0,0,0,16"/>

                                <!-- Feature Toggles -->
                                <TextBlock Text="FITUR &amp; HAK AKSES MODUL:" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,8"/>
                                
                                <ui:Card Margin="0,0,0,8" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="Modul Proposal RAB &amp; Kalkulator" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/>
                                        <CheckBox IsChecked="{Binding AllowRabModule, Mode=TwoWay, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Margin="0,0,0,8" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="Akses Direct Hardware Scanner" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/>
                                        <CheckBox IsChecked="{Binding AllowDirectScanner, Mode=TwoWay, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </ui:Card>

                                <ui:Card Margin="0,0,0,18" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="Watermark Dokumen Demo" VerticalAlignment="Center" Style="{StaticResource BodyStyle}"/>
                                        <CheckBox IsChecked="{Binding HasWatermark, Mode=TwoWay, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </ui:Card>

                                <!-- Save Button -->
                                <ui:Button Appearance="Primary"
                                           Command="{Binding DataContext.SaveTierCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           HorizontalAlignment="Stretch"
                                           Padding="14,9">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock Text="Simpan Paket Ini" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
