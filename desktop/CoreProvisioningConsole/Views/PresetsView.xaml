<UserControl x:Class="CoreProvisioningConsole.Views.PresetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <ds:PageHeader Grid.Row="0"
                       Title="Master Preset Format Kedinasan"
                       Subtitle="Pustaka master template naskah dinas resmi vendor yang otomatis diinjeksi saat instansi baru registrasi."
                       SecondaryActionText="Segarkan"
                       SecondaryActionIcon="ArrowSync24"
                       SecondaryActionCommand="{Binding LoadPresetsCommand}"
                       IsLoading="{Binding IsLoading}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel MaxWidth="1600">

                <!-- TOOLBAR -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding TypeFilterOptions}"
                                  SelectedItem="{Binding SelectedTypeFilter, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <!-- DATA TABLE -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        MinHeight="360"
                        ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding FilteredPresets}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="54"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID Preset" Binding="{Binding Id}" Width="160" FontWeight="Bold"/>
                                <DataGridTextColumn Header="Target Instansi" Binding="{Binding TargetInstitutionType}" Width="160"/>
                                <DataGridTextColumn Header="Nama Kategori Surat" Binding="{Binding CategoryName}" Width="280"/>
                                <DataGridTextColumn Header="Deskripsi Format" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ds:EmptyState Title="Tidak Ada Preset Ditemukan"
                                       Message="Tidak ada master template yang sesuai dengan filter."
                                       Icon="DocumentSearch24"
                                       Visibility="{Binding FilteredPresets.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
