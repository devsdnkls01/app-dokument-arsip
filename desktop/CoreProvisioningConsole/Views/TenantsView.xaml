<UserControl x:Class="CoreProvisioningConsole.Views.TenantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <ds:PageHeader Grid.Row="0"
                       Title="Direktori Instansi &amp; Alokasi Cloud"
                       Subtitle="Daftar instansi klien terdaftar, pemantauan kuota penyimpanan edge, dan kendali status operasional."
                       SecondaryActionText="Segarkan"
                       SecondaryActionIcon="ArrowSync24"
                       SecondaryActionCommand="{Binding LoadTenantsCommand}"
                       IsLoading="{Binding IsLoading}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <StackPanel MaxWidth="1600">

                <!-- TOOLBAR -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:AutoSuggestBox Grid.Column="0"
                                           PlaceholderText="Cari nama instansi, kode, tipe, lisensi..."
                                           Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           Icon="Search24"/>
                    </Grid>
                </Border>

                <!-- DATA TABLE -->
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource BorderLightBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusMedium}"
                        MinHeight="360"
                        ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding FilteredTenants}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  RowHeight="54"
                                  Background="Transparent"
                                  BorderThickness="0">

                            <DataGrid.Columns>
                                <!-- Kode Instansi -->
                                <DataGridTemplateColumn Header="Kode Instansi" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding InstitutionCode}"
                                                       Style="{StaticResource CodeStyle}"
                                                       FontWeight="Bold"
                                                       Margin="14,0"
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Nama Instansi -->
                                <DataGridTemplateColumn Header="Nama Instansi Resmi" Width="260">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                <TextBlock Text="{Binding InstitutionName}" Style="{StaticResource BodyStyle}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding InstitutionAddress}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Tipe Instansi -->
                                <DataGridTextColumn Header="Tipe Entitas" Binding="{Binding InstitutionType}" Width="140"/>

                                <!-- Storage Usage -->
                                <DataGridTemplateColumn Header="Storage Terpakai" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center" Margin="12,0">
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding StorageUsageFormatted}" Style="{StaticResource CaptionStyle}"/>
                                                    <TextBlock Text="{Binding StorageUsagePercent, StringFormat='{}{0:F1}%'}" Style="{StaticResource CaptionStyle}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <ProgressBar Value="{Binding StorageUsagePercent}" Maximum="100" Height="4" BorderThickness="0" Background="{DynamicResource SurfaceCardSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Status Operasional -->
                                <DataGridTemplateColumn Header="Status Operasional" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Margin="12,0" VerticalAlignment="Center">
                                                <ds:StatusBadge Text="{Binding StatusLabel}" Variant="{Binding StatusBadgeVariant}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Aksi Kendali -->
                                <DataGridTemplateColumn Header="Kendali Node" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <ui:Button Appearance="Secondary"
                                                           Padding="12,6"
                                                           Command="{Binding DataContext.ToggleTenantStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           ToolTip="Ubah status operasional instansi (Standby / Normal)">
                                                    <TextBlock Text="{Binding ActionLabel}" FontSize="11" FontWeight="SemiBold"/>
                                                </ui:Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <ds:EmptyState Title="Tidak Ada Instansi Ditemukan"
                                       Message="Tidak ada data instansi yang cocok dengan filter pencarian."
                                       Icon="Building24"
                                       Visibility="{Binding FilteredTenants.Count, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
