<UserControl x:Class="CoreProvisioningConsole.Views.RescueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- PAGE HEADER -->
        <ds:PageHeader Grid.Row="0"
                       Title="Pemulihan Kredensial Pengguna"
                       Subtitle="Prosedur 3-langkah pemulihan kata sandi admin instansi klien secara aman melalui otorisasi pusat."/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,24">
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource BorderLightBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusLarge}"
                    Padding="32"
                    MaxWidth="640"
                    HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="PROSEDUR RESET KATA SANDI INSTANSI" Style="{StaticResource TitleStyle}" FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock Text="Gunakan formulir ini hanya atas permohonan resmi instansi yang terverifikasi." Style="{StaticResource BodyMutedStyle}" Margin="0,0,0,24"/>

                    <!-- STEP 1: Pilih Instansi -->
                    <Border Background="{DynamicResource SurfaceCardSecondaryBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LANGKAH 1: PILIH INSTANSI TERDAFTAR" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Tenants}"
                                      SelectedItem="{Binding SelectedTenant, Mode=TwoWay}"
                                      DisplayMemberPath="InstitutionName"/>
                        </StackPanel>
                    </Border>

                    <!-- STEP 2: Email Username -->
                    <Border Background="{DynamicResource SurfaceCardSecondaryBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="LANGKAH 2: EMAIL USERNAME TERDAFTAR" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="contoh: admin@instansi.go.id"/>
                        </StackPanel>
                    </Border>

                    <!-- STEP 3: Password Baru -->
                    <Border Background="{DynamicResource SurfaceCardSecondaryBrush}" CornerRadius="{StaticResource RadiusMedium}" Padding="16" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="LANGKAH 3: KATA SANDI BARU &amp; KONFIRMASI" Style="{StaticResource CaptionStyle}" FontWeight="Bold" Margin="0,0,0,8"/>
                            <ui:TextBox Text="{Binding NewPassword, Mode=TwoWay}"
                                        PlaceholderText="Ketikkan Kata Sandi Baru (Min. 6 Karakter)"
                                        Margin="0,0,0,10"/>
                            <ui:TextBox Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                        PlaceholderText="Ketik Ulang Konfirmasi Kata Sandi Baru"/>
                        </StackPanel>
                    </Border>

                    <!-- SUBMIT BUTTON -->
                    <ui:Button Appearance="Primary"
                               Command="{Binding SubmitResetPasswordCommand}"
                               HorizontalAlignment="Stretch"
                               Padding="16,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:ProgressRing Width="14" Height="14" Margin="0,0,8,0" IsIndeterminate="True"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <ui:SymbolIcon Symbol="Key24" FontSize="14" Margin="0,0,8,0"
                                           Visibility="{Binding IsLoading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <TextBlock Text="Terapkan Kata Sandi Baru" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
