<Window x:Class="ClientApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sovereign Executive Suite — Autentikasi &amp; Aktivasi Lisensi"
        Icon="pack://application:,,,/ClientApp;component/Assets/logo.png"
        Height="780" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AlabasterSurfaceBrush}"
        ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Text, Segoe UI, Inter, Arial">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT HERO PANEL (OBSIDIAN NAVY) -->
        <Border Grid.Column="0" Background="{StaticResource ObsidianNavyBrush}" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand & Official Badge -->
                <StackPanel Grid.Row="0">
                    <Border Background="#1E293B" CornerRadius="12" Padding="10,8" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="8" Background="#FFFFFF" Margin="0,0,10,0" ClipToBounds="True">
                                <Image Source="pack://application:,,,/ClientApp;component/Assets/logo.png"
                                       Width="30" Height="30" Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SOVEREIGN SUITE" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="Cloud Ecosystem" FontSize="9" Foreground="#94A3B8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Closed-Ecosystem" FontSize="14" Foreground="#94A3B8" FontWeight="Medium"/>
                    <TextBlock Text="Document Automation &amp; Office Suite" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap" Margin="0,4,0,12"/>
                    <TextBlock Text="Ekosistem tertutup persuratan kedinasan, proposal RAB, dan manajemen SDM adaptif multi-tenant." FontSize="13" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>

                <!-- Key Value Propositions -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡️" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Zero-Download Policy" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Dokumen diproses in-memory RAM tanpa file bocor ke folder lokal." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🦎" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Adaptive Chameleon" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Istilah &amp; pustaka template otomatis menyesuaikan jenis instansi." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1E293B" CornerRadius="8" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top"/>
                            <StackPanel>
                                <TextBlock Text="Dual-Mode Office" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="Word WYSIWYG Editor &amp; Excel RAB 1-Click Formula &amp; Terbilang." FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bottom Status Indicator -->
                <StackPanel Grid.Row="2">
                    <Separator Background="#334155" Margin="0,0,0,16"/>
                    <TextBlock Text="Status Server Cloud: 🟢 Terhubung" FontSize="12" Foreground="#34D399" FontWeight="Medium"/>
                    <TextBlock Text="Single-Active-Session Protection Enabled" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RIGHT INTERACTIVE CONTENT PANEL -->
        <Grid Grid.Column="1" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Tab Selector -->
            <Border Grid.Row="0" Background="#E2E8F0" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabLoginRadio" Content="🔑 Masuk ke Sistem (Login)" IsChecked="True" 
                                 GroupName="AuthTabs" Checked="OnTabChanged"
                                 Padding="16,8" FontWeight="SemiBold" FontSize="13"/>
                    <RadioButton x:Name="TabRegisterRadio" Content="✨ Aktivasi Lisensi &amp; Registrasi Baru" 
                                 GroupName="AuthTabs" Checked="OnTabChanged"
                                 Padding="16,8" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,0"/>
                </StackPanel>
            </Border>

            <!-- TAB 1: LOGIN VIEW -->
            <ScrollViewer Grid.Row="1" x:Name="LoginPanel" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Text="Selamat Datang Kembali" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ObsidianNavyBrush}"/>
                    <TextBlock Text="Silakan masukkan kredensial instansi dan akun Anda untuk memulai sesi." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,24"/>

                    <!-- Notification Banner if error -->
                    <Border x:Name="LoginAlertBox" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LoginAlertText" Text="Pesan error" Foreground="#B91C1C" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Kode Instansi -->
                    <TextBlock Text="Kode Instansi" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtLoginTenantCode" Height="38" Padding="10,6" Margin="0,0,0,14" ToolTip="Masukkan Kode Identifikasi Unik Instansi (Huruf Kapital &amp; Angka Tanpa Spasi)"/>

                    <!-- Email Username -->
                    <TextBlock Text="Email / Username Terdaftar" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="TxtLoginEmail" Height="38" Padding="10,6" Margin="0,0,0,14" ToolTip="Ketikkan Alamat Email Aktif Sebagai ID Otorisasi Login"/>

                    <!-- Password -->
                    <TextBlock Text="Kata Sandi (Password)" Style="{StaticResource FormLabelStyle}"/>
                    <PasswordBox x:Name="TxtLoginPassword" Height="38" Padding="10,6" Margin="0,0,0,20" ToolTip="Ketikkan Kata Sandi Pengguna"/>

                    <!-- Submit Button -->
                    <Button Content="Masuk ke Sistem" Style="{StaticResource PrimaryButton}" Height="40" FontSize="14" Click="OnBtnLoginClick"/>

                    <!-- Stealth Support Action -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="[ 💬 Hubungi Kami ]" Style="{StaticResource TextLinkButton}" Click="OnContactHelpdeskClick"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- TAB 2: LICENSE ACTIVATION & ONBOARDING -->
            <ScrollViewer Grid.Row="1" x:Name="RegisterPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                    <TextBlock Text="Aktivasi Lisensi &amp; Pendaftaran Instansi" FontSize="20" FontWeight="Bold" Foreground="{StaticResource ObsidianNavyBrush}"/>
                    <TextBlock Text="Daftarkan instansi baru menggunakan Kode Lisensi resmi yang diterbitkan Developer." FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,20"/>

                    <!-- TAHAP 1: VERIFIKASI LISENSI -->
                    <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="TAHAP 1: KODE LISENSI PEMBELI" FontSize="12" FontWeight="Bold" Foreground="{StaticResource RoyalSapphireBrush}" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtLicenseKeyInput" Height="38" Padding="10,6" Margin="0,0,8,0" ToolTip="Masukkan Token Entitlement / Kode Lisensi Resmi Instansi"/>
                                <Button Grid.Column="1" Content="🔍 Verifikasi Lisensi" Style="{StaticResource PrimaryButton}" Height="38" Click="OnVerifyLicenseClick"/>
                            </Grid>
                            
                            <!-- Verified License Badge -->
                            <Border x:Name="LicenseVerifiedBox" Visibility="Collapsed" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLicenseBadgeTitle" Text="✅ LISENSI VALID: STANDARD TIER" FontWeight="Bold" Foreground="#065F46" FontSize="13"/>
                                    <TextBlock x:Name="TxtLicenseBadgeDetails" Text="Maks. 10 Pengguna • Kuota Cloud 1000 MB • Akses Modul RAB" FontSize="12" Foreground="#047857" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="LicenseErrorBox" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
                                <TextBlock x:Name="TxtLicenseErrorDetails" Text="Kode lisensi tidak valid atau sudah diklaim." Foreground="#B91C1C" FontSize="12"/>
                            </Border>

                            <!-- Stealth License Order Action -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Belum memiliki Kode Lisensi resmi?" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="[ 🛡️ Hubungi Layanan Lisensi ]" Style="{StaticResource TextLinkButton}" Click="OnOrderLicenseClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- TAHAP 2: FORM REGISTRASI LENGKAP -->
                    <Border x:Name="RegistrationFormBox" IsEnabled="False" Opacity="0.5" Background="#FFFFFF" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="TAHAP 2: PROFIL INSTANSI &amp; ADMIN UTAMA" FontSize="12" FontWeight="Bold" Foreground="{StaticResource SlateDarkBrush}" Margin="0,0,0,16"/>

                            <!-- 1. Nama Lengkap Admin -->
                            <TextBlock Text="1. Nama Lengkap Admin Utama" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtRegAdminName" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                            <!-- 2. Nama Instansi -->
                            <TextBlock Text="2. Nama Resmi Instansi" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtRegInstitutionName" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                            <!-- 3. Alamat Instansi -->
                            <TextBlock Text="3. Alamat Lengkap Instansi" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtRegAddress" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Padding="8,4" Margin="0,0,0,12"/>

                            <!-- 4. Jenis Instansi (Adaptive Chameleon Trigger) -->
                            <TextBlock Text="4. Jenis Instansi (Menentukan Istilah &amp; Template Otomatis)" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox x:Name="CmbRegInstitutionType" Height="36" Margin="0,0,0,12">
                                <ComboBoxItem Content="Sekolah / Institusi Pendidikan" Tag="school" IsSelected="True"/>
                                <ComboBoxItem Content="Pemerintahan Desa / Kelurahan / Dinas" Tag="village_gov"/>
                                <ComboBoxItem Content="Perusahaan Swasta / PT / CV" Tag="corporate"/>
                                <ComboBoxItem Content="Perkantoran Umum / Instansi" Tag="office_agency"/>
                                <ComboBoxItem Content="Kesehatan / Rumah Sakit / Klinik" Tag="healthcare"/>
                                <ComboBoxItem Content="Yayasan / Lembaga Swadaya Masyarakat" Tag="foundation"/>
                            </ComboBox>

                            <!-- 5. No Telepon Instansi -->
                            <TextBlock Text="5. Nomor Telepon Resmi Instansi" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtRegPhone" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                            <!-- 6. Email Resmi (Username) -->
                            <TextBlock Text="6. Email Resmi (Terkunci Menjadi Username Login)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="TxtRegEmail" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                            <!-- 7. Password -->
                            <TextBlock Text="7. Kata Sandi Admin (Password)" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox x:Name="TxtRegPassword" Height="36" Padding="10,6" Margin="0,0,0,12"/>

                            <!-- 8. Konfirmasi Password -->
                            <TextBlock Text="8. Konfirmasi Kata Sandi" Style="{StaticResource FormLabelStyle}"/>
                            <PasswordBox x:Name="TxtRegConfirmPassword" Height="36" Padding="10,6" Margin="0,0,0,14"/>

                            <!-- 9. Upload Logo Instansi (Pratinjau Langsung) -->
                            <TextBlock Text="9. Logo Resmi Instansi (PNG/JPG)" Style="{StaticResource FormLabelStyle}"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="60" Height="60" Background="#F1F5F9" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                                    <Image x:Name="ImgLogoPreview" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Button Content="📁 Pilih File Logo..." Style="{StaticResource SecondaryButton}" Height="34" Click="OnSelectLogoClick"/>
                                    <TextBlock x:Name="TxtLogoFileName" Text="Belum ada logo dipilih (opsional)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- Final Submit Registration -->
                            <Button Content="🚀 Daftarkan Instansi &amp; Masuk ke Sistem" Style="{StaticResource SuccessButton}" Height="42" FontSize="14" Click="OnRegisterSubmitClick"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
