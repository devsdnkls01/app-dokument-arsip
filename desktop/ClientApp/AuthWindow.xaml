<ui:FluentWindow x:Class="ClientApp.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ds="clr-namespace:DesignSystem.Controls;assembly=DesignSystem"
        Title="Sovereign Executive Suite — Autentikasi &amp; Aktivasi Lisensi"
        Icon="pack://application:,,,/ClientApp;component/Assets/logo.png"
        Height="820" Width="1140"
        MinHeight="720" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True">

    <Grid Background="{DynamicResource SurfaceAppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. MODERN FLUENT TITLEBAR -->
        <ui:TitleBar Grid.Row="0" Title="Sovereign Executive Suite — Autentikasi &amp; Aktivasi Lisensi">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/ClientApp;component/Assets/logo.png" Width="18" Height="18"/>
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 2. SPLIT WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT HERO PANEL (OBSIDIAN NAVY) -->
            <Border Grid.Column="0" Background="{StaticResource ObsidianNavyBrush}" Padding="32">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand & Official Badge -->
                    <StackPanel Grid.Row="0">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="10,8" HorizontalAlignment="Left" Margin="0,0,0,24">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="{StaticResource RadiusSmall}" Background="#FFFFFF" Margin="0,0,12,0" ClipToBounds="True">
                                    <Image Source="pack://application:,,,/ClientApp;component/Assets/logo.png"
                                           Width="32" Height="32" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SOVEREIGN SUITE" FontSize="12" FontWeight="Bold" Foreground="#38BDF8"/>
                                    <TextBlock Text="Enterprise Cloud Edition" FontSize="9.5" Foreground="#94A3B8"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Closed-Ecosystem" Style="{StaticResource CaptionStyle}" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Document Automation &amp; Office Suite" Style="{StaticResource TitleStyle}" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <TextBlock Text="Ekosistem tertutup persuratan kedinasan, proposal RAB, dan manajemen SDM adaptif multi-tenant." Style="{StaticResource BodyStyle}" Foreground="#CBD5E1" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>

                    <!-- Key Value Propositions with Fluent Cards -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="20" Foreground="#38BDF8" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Zero-Download Policy" Style="{StaticResource SubtitleStyle}" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Dokumen diproses in-memory RAM tanpa file bocor ke folder lokal." Style="{StaticResource CaptionStyle}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="BranchFork24" FontSize="20" Foreground="#F59E0B" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Adaptive Chameleon" Style="{StaticResource SubtitleStyle}" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Istilah &amp; pustaka template otomatis menyesuaikan jenis instansi." Style="{StaticResource CaptionStyle}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="DocumentTable24" FontSize="20" Foreground="#10B981" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Dual-Mode Office" Style="{StaticResource SubtitleStyle}" FontSize="13" Foreground="#FFFFFF"/>
                                    <TextBlock Text="Word WYSIWYG Editor &amp; Excel RAB 1-Click Formula &amp; Terbilang." Style="{StaticResource CaptionStyle}" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Status Indicator -->
                    <StackPanel Grid.Row="2">
                        <Separator Background="#334155" Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource StatusSuccessDotBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="Node D1 Cloud: Operasional Aktif" FontSize="11.5" Foreground="{DynamicResource StatusSuccessFgBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="Single-Active-Session Protection Enabled" FontSize="10" Foreground="#64748B" Margin="16,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT INTERACTIVE CONTENT PANEL -->
            <Grid Grid.Column="1" Margin="36,28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Modern Tab Selector -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusPill}" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabLoginRadio" Content="🔑 Masuk ke Sistem (Login)" IsChecked="True" 
                                     GroupName="AuthTabs" Checked="OnTabChanged"
                                     Padding="16,8" FontWeight="SemiBold" FontSize="13"/>
                        <RadioButton x:Name="TabRegisterRadio" Content="✨ Aktivasi Lisensi &amp; Registrasi Baru" 
                                     GroupName="AuthTabs" Checked="OnTabChanged"
                                     Padding="16,8" FontWeight="SemiBold" FontSize="13" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TAB 1: LOGIN VIEW -->
                <ScrollViewer Grid.Row="1" x:Name="LoginPanel" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="480" HorizontalAlignment="Left">
                        <TextBlock Text="Selamat Datang Kembali" Style="{StaticResource DisplayTitleStyle}" FontSize="24" Margin="0,0,0,4"/>
                        <TextBlock Text="Silakan masukkan kredensial instansi dan akun Anda untuk memulai sesi." Style="{StaticResource CaptionStyle}" FontSize="13" Margin="0,0,0,24"/>

                        <!-- Notification Banner if error -->
                        <Border x:Name="LoginAlertBox" Background="{DynamicResource StatusDangerBgBrush}" BorderBrush="{DynamicResource StatusDangerBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="12" Margin="0,0,0,18" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="16" Foreground="{DynamicResource StatusDangerFgBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="LoginAlertText" Text="Pesan error" Foreground="{DynamicResource StatusDangerFgBrush}" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Kode Instansi -->
                        <TextBlock Text="Kode Instansi" Style="{StaticResource FormLabelStyle}"/>
                        <ui:TextBox x:Name="TxtLoginTenantCode" Height="40" Margin="0,0,0,16" PlaceholderText="Contoh: SMAN1-JKT atau DESA-MAJU"/>

                        <!-- Email Username -->
                        <TextBlock Text="Email / Username Terdaftar" Style="{StaticResource FormLabelStyle}"/>
                        <ui:TextBox x:Name="TxtLoginEmail" Height="40" Margin="0,0,0,16" PlaceholderText="user@instansi.id"/>

                        <!-- Password -->
                        <TextBlock Text="Kata Sandi (Password)" Style="{StaticResource FormLabelStyle}"/>
                        <ui:PasswordBox x:Name="TxtLoginPassword" Height="40" Margin="0,0,0,24" PlaceholderText="Masukkan kata sandi"/>

                        <!-- Submit Button -->
                        <ui:Button Content="Masuk ke Sistem" Appearance="Primary" Height="42" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" Click="OnBtnLoginClick"/>

                        <!-- Stealth Support Action -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <ui:Button Content="[ 💬 Hubungi Kami ]" Appearance="Transparent" Click="OnContactHelpdeskClick" Foreground="{DynamicResource RoyalSapphireBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 2: LICENSE ACTIVATION & ONBOARDING -->
                <ScrollViewer Grid.Row="1" x:Name="RegisterPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="540" HorizontalAlignment="Left">
                        <TextBlock Text="Aktivasi Lisensi &amp; Pendaftaran Instansi" Style="{StaticResource DisplayTitleStyle}" FontSize="22" Margin="0,0,0,4"/>
                        <TextBlock Text="Daftarkan instansi baru menggunakan Kode Lisensi resmi yang diterbitkan Developer." Style="{StaticResource CaptionStyle}" FontSize="13" Margin="0,0,0,20"/>

                        <!-- TAHAP 1: VERIFIKASI LISENSI -->
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="TAHAP 1: KODE LISENSI PEMBELI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource RoyalSapphireBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox x:Name="TxtLicenseKeyInput" Height="40" Margin="0,0,10,0" PlaceholderText="Masukkan Kode Lisensi (Contoh: ENT-STD-2026-XXXX)"/>
                                    <ui:Button Grid.Column="1" Content="Verifikasi Lisensi" Appearance="Primary" Height="40" Click="OnVerifyLicenseClick">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Search24"/>
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                                
                                <!-- Verified License Badge -->
                                <Border x:Name="LicenseVerifiedBox" Visibility="Collapsed" Background="{DynamicResource StatusSuccessBgBrush}" BorderBrush="{DynamicResource StatusSuccessBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="14" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLicenseBadgeTitle" Text="LISENSI VALID: STANDARD TIER" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessFgBrush}" FontSize="13"/>
                                        <TextBlock x:Name="TxtLicenseBadgeDetails" Text="Maks. 10 Pengguna • Kuota Cloud 1000 MB • Akses Modul RAB" FontSize="12" Foreground="{DynamicResource StatusSuccessFgBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="LicenseErrorBox" Visibility="Collapsed" Background="{DynamicResource StatusDangerBgBrush}" BorderBrush="{DynamicResource StatusDangerBorderBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}" Padding="12" Margin="0,10,0,0">
                                    <TextBlock x:Name="TxtLicenseErrorDetails" Text="Kode lisensi tidak valid atau sudah diklaim." Foreground="{DynamicResource StatusDangerFgBrush}" FontSize="12"/>
                                </Border>

                                <!-- Stealth License Order Action -->
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Text="Belum memiliki Kode Lisensi resmi?" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:Button Content="[ 🛡️ Hubungi Layanan Lisensi ]" Appearance="Transparent" Click="OnOrderLicenseClick" Foreground="{DynamicResource RoyalSapphireBrush}" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- TAHAP 2: FORM REGISTRASI LENGKAP -->
                        <Border x:Name="RegistrationFormBox" IsEnabled="False" Opacity="0.5" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="TAHAP 2: PROFIL INSTANSI &amp; ADMIN UTAMA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMainBrush}" Margin="0,0,0,16"/>

                                <!-- 1. Nama Lengkap Admin -->
                                <TextBlock Text="1. Nama Lengkap Admin Utama" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox x:Name="TxtRegAdminName" Height="38" Margin="0,0,0,14" PlaceholderText="Nama lengkap penanggung jawab sistem"/>

                                <!-- 2. Nama Instansi -->
                                <TextBlock Text="2. Nama Resmi Instansi" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox x:Name="TxtRegInstitutionName" Height="38" Margin="0,0,0,14" PlaceholderText="Nama lengkap instansi / lembaga"/>

                                <!-- 3. Alamat Instansi -->
                                <TextBlock Text="3. Alamat Lengkap Instansi" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox x:Name="TxtRegAddress" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" PlaceholderText="Alamat kantor dinas / sekolah / perusahaan"/>

                                <!-- 4. Jenis Instansi (Adaptive Chameleon Trigger) -->
                                <TextBlock Text="4. Jenis Instansi (Menentukan Istilah &amp; Template Otomatis)" Style="{StaticResource FormLabelStyle}"/>
                                <ComboBox x:Name="CmbRegInstitutionType" Height="38" Margin="0,0,0,14">
                                    <ComboBoxItem Content="Sekolah / Institusi Pendidikan" Tag="school" IsSelected="True"/>
                                    <ComboBoxItem Content="Pemerintahan Desa / Kelurahan / Dinas" Tag="village_gov"/>
                                    <ComboBoxItem Content="Perusahaan Swasta / PT / CV" Tag="corporate"/>
                                    <ComboBoxItem Content="Perkantoran Umum / Instansi" Tag="office_agency"/>
                                    <ComboBoxItem Content="Kesehatan / Rumah Sakit / Klinik" Tag="healthcare"/>
                                    <ComboBoxItem Content="Yayasan / Lembaga Swadaya Masyarakat" Tag="foundation"/>
                                </ComboBox>

                                <!-- 5. No Telepon Instansi -->
                                <TextBlock Text="5. Nomor Telepon Resmi Instansi" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox x:Name="TxtRegPhone" Height="38" Margin="0,0,0,14" PlaceholderText="08xxxxxxxx / (021) xxxxxx"/>

                                <!-- 6. Email Resmi (Username) -->
                                <TextBlock Text="6. Email Resmi (Terkunci Menjadi Username Login)" Style="{StaticResource FormLabelStyle}"/>
                                <ui:TextBox x:Name="TxtRegEmail" Height="38" Margin="0,0,0,14" PlaceholderText="admin@instansi.sch.id atau info@instansi.go.id"/>

                                <!-- 7. Password -->
                                <TextBlock Text="7. Kata Sandi Admin (Password)" Style="{StaticResource FormLabelStyle}"/>
                                <ui:PasswordBox x:Name="TxtRegPassword" Height="38" Margin="0,0,0,14" PlaceholderText="Minimal 6 karakter"/>

                                <!-- 8. Konfirmasi Password -->
                                <TextBlock Text="8. Konfirmasi Kata Sandi" Style="{StaticResource FormLabelStyle}"/>
                                <ui:PasswordBox x:Name="TxtRegConfirmPassword" Height="38" Margin="0,0,0,16" PlaceholderText="Ketik ulang kata sandi"/>

                                <!-- 9. Upload Logo Instansi (Pratinjau Langsung) -->
                                <TextBlock Text="9. Logo Resmi Instansi (PNG/JPG)" Style="{StaticResource FormLabelStyle}"/>
                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="64" Height="64" Background="{DynamicResource SurfaceCardSubtleBrush}" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusNormal}">
                                        <Image x:Name="ImgLogoPreview" Stretch="Uniform" Margin="4"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <ui:Button Content="Pilih File Logo..." Appearance="Secondary" Height="36" Click="OnSelectLogoClick">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24"/>
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <TextBlock x:Name="TxtLogoFileName" Text="Belum ada logo dipilih (opsional)" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Final Submit Registration -->
                                <ui:Button Content="Daftarkan Instansi &amp; Masuk ke Sistem" Appearance="Primary" Height="44" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Stretch" Click="OnRegisterSubmitClick"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
