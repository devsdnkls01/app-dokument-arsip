# .gitignore for Monorepo (Cloudflare Workers + .NET WPF)

# OS / Editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Backend (Node / Cloudflare Workers)
backend/node_modules/
backend/dist/
backend/.wrangler/
.wrangler/
backend/.dev.vars
backend/.env
backend/.env.local
*.log

# Desktop (.NET / WPF)
dist/
**/bin/
**/obj/
bin/
obj/
*.user
*.suo
**/TestResults/
*.tmp
*.docx
!desktop/Templates/*.docx
node_state.dat
*.zip

